    "/genre": {
      "post": {
        "summary": "Dodaj novi žanr",
        "description": "Kreira novi žanr u bazi podataka.",
        "operationId": "createGenre",
        "tags": ["genre"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "readable_name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 20,
                    "description": "Skraćeni naziv žanra"
                  },
                  "readable_name": {
                    "type": "string",
                    "maxLength": 60,
                    "description": "Čitljivi naziv žanra"
                  },
                  "parent": {
                    "type": "string",
                    "maxLength": 20,
                    "nullable": true,

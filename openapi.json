  "components": {
    "schemas": {
      "Company": {
        "type": "object",
        "title": "Company",
        "description": "Kompanija (izdavač ili developer).",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "integer",
            "title": "ID",
            "description": "Jedinstveni identifikator kompanije."
          },
          "name": {
            "type": "string",
            "maxLength": 60,
            "title": "Name",
            "description": "Ime kompanije."
          },
          "country_code": {
            "type": "string",
            "maxLength": 2,
            "nullable": true,
            "title": "Country code",
            "description": "Država kompanije, ISO 3166 format."
          },
          "parent": {
            "type": "integer",
            "nullable": true,
            "title": "Parent",
            "description": "ID roditeljske kompanije."
          }
        }
      },
      "Genre": {
        "type": "object",
        "title": "Genre",
        "description": "Žanr video igre.",
        "required": ["name", "readable_name"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20,
            "title": "Name",
            "description": "Skraćeni naziv žanra."
          },
          "readable_name": {
            "type": "string",
            "maxLength": 60,
            "title": "Readable name",
            "description": "Čitljivi naziv žanra."
          },
          "parent": {
            "type": "string",
            "maxLength": 20,
            "nullable": true,
            "title": "Parent",
            "description": "Nadređeni žanr."
          }
        }
      },
      "Game": {
        "type": "object",
        "title": "Game",
        "description": "Objekt koji sadrži sve podatke o jednoj igri.",
        "required": ["id", "name", "publisher", "developer", "release_date"],
        "properties": {
          "id": {
            "type": "integer",
            "title": "ID",
            "description": "Jedinstveni identifikator igre."
          },
          "name": {
            "type": "string",
            "maxLength": 60,
            "title": "Name",
            "description": "Naziv igre."
          },
          "publisher": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Company"
              },
              {
                "title": "Publisher",
                "description": "Izdavač igre."
              }
            ]
          },
          "developer": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Company"
              },
              {
                "title": "Developer",
                "description": "Autor igre."
              }
            ]
          },
          "release_date": {
            "type": "string",
            "format": "date",
            "title": "Release date",
            "description": "Datum izdavanja, ako ih ima više, onaj prvi. ISO 8601 format."
          },
          "genres": {
            "type": "array",
            "title": "Genres",
            "description": "Popis žanrova kojima igra pripada.",
            "items": {
              "$ref": "#/components/schemas/Genre"
            }
          },
          "score": {
            "type": "integer",
            "nullable": true,
            "title": "Score",
            "description": "\"Top Critic Average\" ocjena sa stranice https://opencritic.com/"
          },
          "length": {
            "type": "number",
            "nullable": true,
            "title": "Length",
            "description": "\"Main + Sides\" duljina trajanja igre sa stranice https://howlongtobeat.com/"
          },
          "has_multiplayer": {
            "type": "boolean",
            "nullable": true,
            "title": "Has multiplayer?",
            "description": "Boolean koji određuje ima li igra podršku za multiplayer."
          }
        }
      },
      "GameArray": {
        "type": "array",
        "title": "OR Video Igre",
        "description": "Skup video igri za otvoreno računarstvo.",
        "items": {
          "$ref": "#/components/schemas/Game"
        }
      }
    }
  }
}
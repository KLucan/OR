                    "name": {
                      "type": "string",
                      "description": "Naziv novo kreiranog žanra."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Neispravni podaci u zahtjevu."
          },
          "500": {
            "description": "Greška na serveru."
          }
        }
      }
    },

{
  "openapi": "3.1.0",
  "info": {
    "title": "OR Laboratorijske vježbe",
    "description": "Stranica s informacijama o video igrama za potrebe laboratorijskih vježbi predmeta Otvoreno Računarstvo.",
    "contact": {
      "email": "karlo.lucan@fer.hr"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/license/mit"
    },
    "version": "3.0.0"
  },
  "tags": [
    {
      "name": "game",
      "description": "Podaci o igri"
    },
    {
      "name": "company",
      "description": "Podaci o firmi koja razvija ili izdaje igre"
    },
    {
      "name": "genre",
      "description": "Podaci o žanru igara"
    }
  ],
  "paths": {
    "/dump": {
      "get": {
        "summary": "Dohvati sve igre",
        "description": "Vraća kompletnu kolekciju video igara.",
        "operationId": "getAllGames",
        "tags": ["game"],
        "responses": {
          "200": {
            "description": "Uspješno dohvaćena kolekcija igara.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameArray"
                }
              }
            }
          },
          "500": {
            "description": "Greška na serveru."
          }
        }
      }
    },
    "/game": {
      "post": {
        "summary": "Dodaj novu igru",
        "description": "Kreira novu igru u bazi podataka.",
        "operationId": "createGame",
        "tags": ["game"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "publisher", "developer", "release_date"],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "publisher": {
                    "type": "integer",
                    "description": "ID izdavača"
                  },
                  "developer": {
                    "type": "integer",
                    "description": "ID developera"
                  },
                  "release_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "genres": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Popis žanrova (skraćeni nazivi)"
                  },
                  "score": {
                    "type": "integer",
                    "nullable": true
                  },
                  "length": {
                    "type": "number",
                    "nullable": true
                  },
                  "has_multiplayer": {
                    "type": "boolean",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Igra uspješno kreirana.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "ID novo kreirane igre."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Neispravni podaci u zahtjevu."
          },
          "500": {
            "description": "Greška na serveru."
          }
        }
      }
    },
    "/game/{id}": {
      "get": {
        "summary": "Dohvati igru po ID-u",
        "description": "Vraća podatke o jednoj igri na temelju jedinstvenog identifikatora.",
        "operationId": "getGameById",
        "tags": ["game"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Jedinstveni identifikator igre.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Uspješno dohvaćena igra.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "404": {
            "description": "Igra s navedenim ID-om nije pronađena."
          },
          "500": {
            "description": "Greška na serveru."
          }
        }
      },
      "put": {
        "summary": "Ažuriraj igru",
        "description": "Ažurira postojeću igru na temelju ID-a.",
        "operationId": "updateGame",
        "tags": ["game"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Jedinstveni identifikator igre.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "publisher", "developer", "release_date"],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "publisher": {
                    "type": "integer",
                    "description": "ID izdavača"
                  },
                  "developer": {
                    "type": "integer",
                    "description": "ID developera"
                  },
                  "release_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "genres": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Popis žanrova (skraćeni nazivi)"
                  },
                  "score": {
                    "type": "integer",
                    "nullable": true
                  },
                  "length": {
                    "type": "number",
                    "nullable": true
                  },
                  "has_multiplayer": {
                    "type": "boolean",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Igra uspješno ažurirana."
          },
          "400": {
            "description": "Neispravni podaci u zahtjevu."
          },
          "404": {
            "description": "Igra s navedenim ID-om nije pronađena."
          },
          "500": {
            "description": "Greška na serveru."
          }
        }
      },
      "delete": {
        "summary": "Obriši igru",
        "description": "Briše igru iz baze podataka na temelju ID-a.",
        "operationId": "deleteGame",
        "tags": ["game"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Jedinstveni identifikator igre.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Igra uspješno obrisana."
          },
          "404": {
            "description": "Igra s navedenim ID-om nije pronađena."
          },
          "500": {
            "description": "Greška na serveru."
          }
        }
      }
    },
    "/game/genre/{name}": {
      "get": {
        "summary": "Dohvati igre po žanru",
        "description": "Vraća popis igara koje pripadaju određenom žanru.",
        "operationId": "getGamesByGenre",
        "tags": ["game"],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Skraćeni naziv žanra (npr. \"FPS\", \"RPG\", \"RTS\").",
            "schema": {
              "type": "string",
              "maxLength": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Uspješno dohvaćene igre za navedeni žanr.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameArray"
                }
              }
            }
          },
          "404": {
            "description": "Žanr s navedenim nazivom nije pronađen."
          },
          "500": {
            "description": "Greška na serveru."
          }
        }
      }
    },
